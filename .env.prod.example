# SUPPORT (NMate) — .env for the PRODUCTION server.
#
# Copy to `.env` next to docker-compose.prod.yml on the server, then fill in real values.
# This file holds secrets — chmod 600, never commit it, never bake it into an image.

# ─── Image registry ──────────────────────────────────────────────────────────
# GitHub user/org that owns the GHCR packages (the part after ghcr.io/).
GHCR_OWNER=namne2kzz

# THE ONLY LINE CD REWRITES. Do not edit by hand except for a manual rollback.
# Value is the first 7 characters of the git SHA. Leave "latest" initially; CD overwrites it.
SUPPORT_TAG=latest

# ─── Database ────────────────────────────────────────────────────────────────
SUPPORT_PG_USER=support
SUPPORT_PG_PASSWORD=REPLACE_strong_password

# ─── LLM ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# ─── Callers — MUST match the product's .env on the same server ──────────────
# DASHBOARD/.env → NMATE_INTERNAL_TOKEN
NMATE_INTERNAL_TOKEN_DASHBOARD=REPLACE_min_32_chars_must_match_dashboard

# ─── Behaviour ───────────────────────────────────────────────────────────────
# false = decline questions the documentation does not cover instead of answering generally.
NMATE_ALLOW_GENERAL_KNOWLEDGE=true
# Loopback host port (health probe + reindex). DASHBOARD's knowledge-sync calls 127.0.0.1:<this>.
SUPPORT_PORT=8095
